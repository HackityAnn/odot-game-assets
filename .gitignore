# Blender backup files; editable .blend sources remain tracked.
*.blend[0-9]*
*.blend@

# Local experiments, caches and Python environments.
/scratch/
/.lavish/
/.cache/
/.ruff_cache/
.venv/
__pycache__/
*.pyc
mise.local.toml
mise.local.lock
.DS_Store

# Disposable catalog output and thumbnail cache; rendered PNGs can be committed.
/exports/catalog.json
/exports/thumbnails/state.json
/exports/thumbnails/**/*.rendering.png
/dist/
